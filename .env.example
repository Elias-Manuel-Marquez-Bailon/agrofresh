# ==========================================================
# AgroFresh - Variables de entorno
# Copia este archivo a .env y cambia los valores:  cp .env.example .env
# NUNCA subas el archivo .env al repositorio.
# ==========================================================

# ---------- Base de datos (MySQL 8) ----------
MYSQL_DATABASE=agrofresh
MYSQL_USER=agrofresh_user
MYSQL_PASSWORD=cambia_esta_password
MYSQL_ROOT_PASSWORD=cambia_esta_root_password

# ---------- Backend (Spring Boot) ----------
# Clave para firmar JWT: mínimo 32 caracteres (256 bits). Genera una con:
#   openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_de_al_menos_32_chars
# Expiración del token en milisegundos (86400000 = 24 h)
JWT_EXPIRATION=86400000
# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ---------- Frontend (Nginx) ----------
# Puerto público del frontend en el host
FRONTEND_PORT=80
